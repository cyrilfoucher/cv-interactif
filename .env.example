# Modèle des variables d'environnement.
# Copiez ce fichier en .env.local et remplacez les valeurs. Ne mettez jamais de vraie clé ici.

# Clé de l'API Mistral (console.mistral.ai). Lue uniquement par la route /api/ask.
MISTRAL_API_KEY=

# Base Upstash Redis pour la limite de questions (Marketplace Vercel).
# Obligatoires en production. Facultatives en local : sans elles, la limite se fait en mémoire.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Secret qui sert à masquer les adresses IP dans la base (une longue chaîne aléatoire).
# Obligatoire en production. Générer : openssl rand -hex 32
RATE_LIMIT_SECRET=
